package pages

import (
	"fmt"

	"github.com/drywaters/learnd/internal/model"
	"github.com/drywaters/learnd/internal/ui"
	"github.com/drywaters/learnd/internal/ui/components"
	"github.com/drywaters/learnd/internal/ui/layout"
	"github.com/drywaters/learnd/internal/ui/partials"
)

var sourceTypeOptions = []struct {
	value model.SourceType
	label string
}{
	{model.SourceTypeYouTube, "YouTube"},
	{model.SourceTypePodcast, "Podcast"},
	{model.SourceTypeArticle, "Article"},
	{model.SourceTypeDoc, "Documentation"},
	{model.SourceTypeOther, "Other"},
}

func matchingEntriesHeading(total int) string {
	if total == 1 {
		return "1 matching entry"
	}
	return fmt.Sprintf("%d matching entries", total)
}

templ CapturePage(entries []ui.EntryView, pagination ui.PaginationView, filter ui.DashboardFilter, totalEntries int, prefillURL string) {
	@layout.Base("Capture - learnd") {
		<div class="min-h-screen">
			@components.CaptureHeader()

			<main class="max-w-4xl mx-auto px-4 py-8">
				<!-- Capture Form -->
				<div class="card p-6 md:p-8 mb-8">
					<form
						id="capture-form"
						hx-post="/api/entries"
						hx-target="#entry-list"
						hx-swap="afterbegin"
						hx-on::after-request="if(event.detail.successful && event.detail.xhr.getResponseHeader('X-Entry-Created') === 'true') { this.reset(); document.getElementById('url').focus(); }"
					>
						<!-- URL and Tag Row -->
						<div class="flex flex-col md:flex-row gap-4 mb-4">
							<div class="flex-grow">
								<label for="url" class="block text-sm font-medium mb-2" style="color: var(--color-ink-light);">
									URL
								</label>
								<input
									type="url"
									id="url"
									name="url"
									value={ prefillURL }
									class="input-field input-url w-full"
									placeholder="https://..."
									autocomplete="off"
									autofocus
									required
								/>
							</div>
							<div class="md:w-48">
								<label for="tag" class="block text-sm font-medium mb-2" style="color: var(--color-ink-light);">
									Tag
								</label>
								<input
									type="text"
									id="tag"
									name="tag"
									class="input-field w-full"
									placeholder="ai"
									pattern="[a-z0-9\-]*"
									title="Lowercase letters, numbers, and hyphens only"
									autocomplete="off"
								/>
							</div>
						</div>

						<div id="form-error" class="mb-4"></div>
						<div id="duplicate-warning" class="mb-4"></div>

						<!-- Optional Fields Row -->
						<div class="flex flex-col sm:flex-row gap-4 mb-6">
							<div class="sm:w-32">
								<label for="time_spent" class="block text-xs font-medium mb-1.5" style="color: var(--color-ink-lighter);">
									Time (min)
								</label>
								<input
									type="number"
									id="time_spent"
									name="time_spent"
									class="input-field w-full text-sm"
									placeholder="30"
									min="1"
								/>
							</div>
							<div class="sm:w-32">
								<label for="quantity" class="block text-xs font-medium mb-1.5" style="color: var(--color-ink-lighter);">
									Quantity
								</label>
								<input
									type="number"
									id="quantity"
									name="quantity"
									class="input-field w-full text-sm"
									placeholder="e.g. pages"
									min="1"
								/>
							</div>
							<div class="flex-grow">
								<label for="notes" class="block text-xs font-medium mb-1.5" style="color: var(--color-ink-lighter);">
									Notes
								</label>
								<input
									type="text"
									id="notes"
									name="notes"
									class="input-field w-full text-sm"
									placeholder="Optional notes..."
								/>
							</div>
						</div>

						<!-- Submit Button -->
						<div class="flex justify-end">
							<button type="submit" class="btn-primary relative flex items-center justify-center pl-6">
								<span class="htmx-indicator">
									<span class="animate-spin inline-block">
										@components.SpinnerIcon()
									</span>
								</span>
								<span>Save Entry</span>
							</button>
						</div>
					</form>
				</div>

				@dashboardFilters(filter)
				@CaptureEntriesSection(entries, pagination, filter, totalEntries)
			</main>
		</div>
		@keyboardSubmitScript()
	}
}

// dashboardFilters sits outside the entries region so typing in the search
// box keeps focus while the region below is swapped. Changing a filter
// starts again from page 1. The controls share one request queue so a slow
// response cannot overwrite a newer one.
templ dashboardFilters(filter ui.DashboardFilter) {
	<form
		id="dashboard-filters"
		action="/"
		method="get"
		role="search"
		class="flex flex-col sm:flex-row gap-3 mb-6"
		hx-get="/"
		hx-target="#dashboard-entries-region"
		hx-select="#dashboard-entries-region"
		hx-swap="outerHTML show:none"
		hx-push-url="true"
		hx-include="#dashboard-filters"
		hx-sync="this:replace"
	>
		<input
			type="search"
			id="dashboard-search"
			name="q"
			value={ filter.Query }
			class="input-field w-full sm:flex-grow"
			placeholder="Search entries..."
			aria-label="Search entries"
			autocomplete="off"
			maxlength="200"
			hx-get="/"
			hx-trigger="input changed delay:300ms"
		/>
		<div class="grid grid-cols-2 gap-3 sm:flex sm:shrink-0">
			<select
				name="tag"
				class="input-field input-select w-full pr-10 sm:w-40"
				aria-label="Filter by tag"
				hx-get="/"
				hx-trigger="change"
			>
				<option value="">All tags</option>
				for _, tag := range filter.Tags {
					<option value={ tag } selected?={ tag == filter.Tag }>{ tag }</option>
				}
			</select>
			<select
				name="type"
				class="input-field input-select w-full pr-10 sm:w-40"
				aria-label="Filter by type"
				hx-get="/"
				hx-trigger="change"
			>
				<option value="">All types</option>
				for _, option := range sourceTypeOptions {
					<option value={ string(option.value) } selected?={ string(option.value) == filter.SourceType }>{ option.label }</option>
				}
			</select>
		</div>
		<noscript>
			<button type="submit" class="btn-secondary w-full sm:w-auto h-full justify-center">Apply</button>
		</noscript>
	</form>
	@dashboardFiltersHistoryScript()
}

templ dashboardFiltersHistoryScript() {
	<script>
		// htmx history snapshots keep the markup, not live input values, so
		// Back/Forward would show one filter's results under another's
		// controls. Restore the controls from the restored URL instead.
		(function () {
			if (window.__dashboardFiltersHistoryInitialized) {
				return;
			}
			window.__dashboardFiltersHistoryInitialized = true;

			document.addEventListener('htmx:historyRestore', function() {
				const form = document.getElementById('dashboard-filters');
				if (!form) {
					return;
				}
				const params = new URLSearchParams(window.location.search);
				for (const name of ['q', 'tag', 'type']) {
					form.elements[name].value = params.get(name) || '';
				}
			});
		})();
	</script>
}

templ CaptureEntriesSection(entries []ui.EntryView, pagination ui.PaginationView, filter ui.DashboardFilter, totalEntries int) {
	<div id="dashboard-entries-region">
		<div class="flex items-center justify-between mb-4 gap-4">
			<h2 class="font-display text-lg font-medium" style="color: var(--color-ink);">
				if filter.Active() {
					{ matchingEntriesHeading(totalEntries) }
				} else {
					Recent Entries
				}
			</h2>
			@paginationControls(pagination)
		</div>

		<div class="card overflow-hidden">
			<div id="entry-list" class="divide-y" style="border-color: var(--color-warm-gray);">
				if len(entries) > 0 {
					for _, entry := range entries {
						@partials.EntryRow(entry)
					}
				}
			</div>
			if filter.Active() && len(entries) == 0 {
				<div id="empty-state" class="p-8 text-center text-sm" style="color: var(--color-ink-lighter);">
					<p>No entries match.</p>
					<a href="/" class="inline-block mt-2 text-xs hover:underline" style="color: var(--color-accent);">Clear filters</a>
				</div>
			} else {
				@partials.EmptyState(len(entries) == 0, false)
			}
		</div>

		<div class="mt-6 flex justify-end">
			@paginationControls(pagination)
		</div>
	</div>
}

templ paginationControls(pagination ui.PaginationView) {
	<div class="flex items-center gap-3 text-xs" style="color: var(--color-ink-lighter);">
		if pagination.HasPrevious {
			<a
				href={ templ.SafeURL(pagination.PreviousURL) }
				hx-get={ pagination.PreviousURL }
				hx-target="#dashboard-entries-region"
				hx-select="#dashboard-entries-region"
				hx-swap="outerHTML show:none"
				hx-push-url="true"
				class="text-xs hover:underline"
				style="color: var(--color-accent);"
			>
				Previous
			</a>
		} else {
			<span class="text-xs opacity-50">Previous</span>
		}
		<span>Page { fmt.Sprintf("%d", pagination.CurrentPage) } of { fmt.Sprintf("%d", pagination.TotalPages) }</span>
		if pagination.HasNext {
			<a
				href={ templ.SafeURL(pagination.NextURL) }
				hx-get={ pagination.NextURL }
				hx-target="#dashboard-entries-region"
				hx-select="#dashboard-entries-region"
				hx-swap="outerHTML show:none"
				hx-push-url="true"
				class="text-xs hover:underline"
				style="color: var(--color-accent);"
			>
				Next
			</a>
		} else {
			<span class="text-xs opacity-50">Next</span>
		}
	</div>
}

templ keyboardSubmitScript() {
	<script>
		// hx-boost re-runs this script on each visit; bind the document listener once.
		(function () {
			if (window.__captureKeyboardSubmitInitialized) {
				return;
			}
			window.__captureKeyboardSubmitInitialized = true;

			document.addEventListener('keydown', function(e) {
				if (e.shiftKey && e.key === 'Enter') {
					const form = document.getElementById('capture-form');
					if (form) {
						e.preventDefault();
						htmx.trigger(form, 'submit');
					}
				}
			});
		})();
	</script>
}

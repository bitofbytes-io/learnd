package pages

import (
	"fmt"

	"github.com/drywaters/learnd/internal/ui"
	"github.com/drywaters/learnd/internal/ui/components"
	"github.com/drywaters/learnd/internal/ui/layout"
	"github.com/drywaters/learnd/internal/ui/partials"
)

templ CapturePage(entries []ui.EntryView, pagination ui.PaginationView, prefillURL string) {
	@layout.Base("Capture - learnd") {
		<div class="min-h-screen">
			@components.CaptureHeader()

			<main class="max-w-4xl mx-auto px-4 py-8">
				<!-- Capture Form -->
				<div class="card p-6 md:p-8 mb-8">
					<form
						id="capture-form"
						hx-post="/api/entries"
						hx-target="#entry-list"
						hx-swap="afterbegin"
						hx-on::after-request="if(event.detail.successful && event.detail.xhr.getResponseHeader('X-Entry-Created') === 'true') { this.reset(); document.getElementById('url').focus(); }"
					>
						<!-- URL and Tag Row -->
						<div class="flex flex-col md:flex-row gap-4 mb-4">
							<div class="flex-grow">
								<label for="url" class="block text-sm font-medium mb-2" style="color: var(--color-ink-light);">
									URL
								</label>
								<input
									type="url"
									id="url"
									name="url"
									value={ prefillURL }
									class="input-field input-url w-full"
									placeholder="https://..."
									autocomplete="off"
									autofocus
									required
								/>
							</div>
							<div class="md:w-48">
								<label for="tag" class="block text-sm font-medium mb-2" style="color: var(--color-ink-light);">
									Tag
								</label>
								<input
									type="text"
									id="tag"
									name="tag"
									class="input-field w-full"
									placeholder="ai"
									pattern="[a-z0-9-]*"
									title="Lowercase letters, numbers, and hyphens only"
									autocomplete="off"
								/>
							</div>
						</div>

						<div id="form-error" class="mb-4"></div>
						<div id="duplicate-warning" class="mb-4"></div>

						<!-- Optional Fields Row -->
						<div class="flex flex-col sm:flex-row gap-4 mb-6">
							<div class="sm:w-32">
								<label for="time_spent" class="block text-xs font-medium mb-1.5" style="color: var(--color-ink-lighter);">
									Time (min)
								</label>
								<input
									type="number"
									id="time_spent"
									name="time_spent"
									class="input-field w-full text-sm"
									placeholder="30"
									min="1"
								/>
							</div>
							<div class="sm:w-32">
								<label for="quantity" class="block text-xs font-medium mb-1.5" style="color: var(--color-ink-lighter);">
									Quantity
								</label>
								<input
									type="number"
									id="quantity"
									name="quantity"
									class="input-field w-full text-sm"
									placeholder="e.g. pages"
									min="1"
								/>
							</div>
							<div class="flex-grow">
								<label for="notes" class="block text-xs font-medium mb-1.5" style="color: var(--color-ink-lighter);">
									Notes
								</label>
								<input
									type="text"
									id="notes"
									name="notes"
									class="input-field w-full text-sm"
									placeholder="Optional notes..."
								/>
							</div>
						</div>

						<!-- Submit Button -->
						<div class="flex justify-end">
							<button type="submit" class="btn-primary relative flex items-center justify-center pl-6">
								<span class="htmx-indicator">
									<span class="animate-spin inline-block">
										@components.SpinnerIcon()
									</span>
								</span>
								<span>Save Entry</span>
							</button>
						</div>
					</form>
				</div>

				@CaptureEntriesSection(entries, pagination)
			</main>
		</div>
		@keyboardSubmitScript()
	}
}

templ CaptureEntriesSection(entries []ui.EntryView, pagination ui.PaginationView) {
	<div id="dashboard-entries-region">
		<div class="flex items-center justify-between mb-4 gap-4">
			<h2 class="font-display text-lg font-medium" style="color: var(--color-ink);">
				Recent Entries
			</h2>
			@paginationControls(pagination)
		</div>

		<div class="card overflow-hidden">
			<div id="entry-list" class="divide-y" style="border-color: var(--color-warm-gray);">
				if len(entries) > 0 {
					for _, entry := range entries {
						@partials.EntryRow(entry)
					}
				}
			</div>
			@partials.EmptyState(len(entries) == 0, false)
		</div>

		<div class="mt-6 flex justify-end">
			@paginationControls(pagination)
		</div>
	</div>
}

templ paginationControls(pagination ui.PaginationView) {
	<div class="flex items-center gap-3 text-xs" style="color: var(--color-ink-lighter);">
		if pagination.HasPrevious {
			<a
				href={ templ.SafeURL(pagination.PreviousURL) }
				hx-get={ pagination.PreviousURL }
				hx-target="#dashboard-entries-region"
				hx-select="#dashboard-entries-region"
				hx-swap="outerHTML show:none"
				hx-push-url="true"
				class="text-xs hover:underline"
				style="color: var(--color-accent);"
			>
				Previous
			</a>
		} else {
			<span class="text-xs opacity-50">Previous</span>
		}
		<span>Page { fmt.Sprintf("%d", pagination.CurrentPage) } of { fmt.Sprintf("%d", pagination.TotalPages) }</span>
		if pagination.HasNext {
			<a
				href={ templ.SafeURL(pagination.NextURL) }
				hx-get={ pagination.NextURL }
				hx-target="#dashboard-entries-region"
				hx-select="#dashboard-entries-region"
				hx-swap="outerHTML show:none"
				hx-push-url="true"
				class="text-xs hover:underline"
				style="color: var(--color-accent);"
			>
				Next
			</a>
		} else {
			<span class="text-xs opacity-50">Next</span>
		}
	</div>
}

templ keyboardSubmitScript() {
	<script>
		document.addEventListener('keydown', function(e) {
			if (e.shiftKey && e.key === 'Enter') {
				e.preventDefault();
				const form = document.getElementById('capture-form');
				if (form) {
					htmx.trigger(form, 'submit');
				}
			}
		});
	</script>
}

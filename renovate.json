{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekly dependency updates for learnd (Go modules, GitHub Actions, Dockerfile). Replaces Dependabot.",
  "extends": ["config:recommended"],
  "schedule": ["* * * * 4"],
  "packageRules": [
    {
      "description": "One weekly PR for every non-major update; majors stay separate PRs.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "One weekly PR for non-major GitHub Actions updates; majors stay separate PRs.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Pin Dockerfile base images by digest.",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "description": "Tailwind release updates require all platform hashes in tools/tailwind.env to be reviewed together.",
      "matchPackageNames": ["tailwindlabs/tailwindcss"],
      "allowedVersions": "<5",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tools/tailwind.env$/", "/^Makefile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n(?:TAILWIND_VERSION=|GOLANGCI_LINT_VERSION := )(?<currentValue>\\S+)"],
      "versioningTemplate": "semver"
    }
  ]
}
